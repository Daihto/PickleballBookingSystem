{
  "name": "pickleballbookingsystem",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite\"",
    "server": "tsx watch server.ts",
    "build": "tsc -b && vite build",
